# ========== AI模型配置 ==========
# DeepSeek官方API
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=your_deepseek_api_key_here
AI_API_MODEL=deepseek-v4-flash
AI_AGENT_MODEL=deepseek-v4-flash

# DeepSeek嵌入模型
AI_EMBEDDING_URL=https://api.deepseek.com/v1/embeddings
AI_EMBEDDING_KEY=your_deepseek_api_key_here
AI_EMBEDDING_MODEL=deepseek-v4-flash

# ========== 数据库配置 ==========
SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/cloud_bridge;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=password